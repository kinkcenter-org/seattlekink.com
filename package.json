{
	"name": "seattlekink.com",
	"version": "0.2.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"lint": "biome lint",
		"format": "biome check --write --unsafe",
		"deploy": "bun run build && wrangler deploy"
	},
	"dependencies": {
		"next": "16.3.8",
		"react": "19.3.0",
		"react-dom": "19.3.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/bun": "^1.4.2",
		"@types/node": "^26.6.4",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"bun": "^1.4.2",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"wrangler": "^4.147.0"
	},
	"overrides": {
		"react": "$react",
		"react-dom": "$react-dom",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3"
	},
	"trustedDependencies": [
		"@tailwindcss/oxide"
	]
